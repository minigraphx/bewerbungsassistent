{
  "manifest_version": 3,
  "name": "Bewerbungsassistent",
  "version": "0.2.1",
  "description": "Sucht Stellen und Lehrstellen nach dem Suchprofil, prüft Inserate auf Klick und gibt sie an die App Bewerbungsassistent.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "host_permissions": [
    "https://www.job-room.ch/*",
    "https://www.jobs.ch/*",
    "https://www.jobscout24.ch/*",
    "https://ictjobs.ch/*",
    "https://www.ictjobs.ch/*",
    "https://www.berufsberatung.ch/*",
    "https://www.yousty.ch/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Bewerbungsassistent",
             "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["app-bridge.js"], "run_at": "document_idle"}]
}
