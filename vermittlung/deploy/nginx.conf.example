# /etc/nginx/sites-available/<domain>, verlinkt nach sites-enabled. Domain und Zertifikat anpassen.
# Protokoll ohne Adresse der Person und ohne Kopfzeilen: x-api-key enthält den Zugang.
log_format vermittlung_safe '[$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';
limit_req_zone $binary_remote_addr zone=vermittlung_redeem:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=vermittlung_api:1m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name ki.example.ch;
    access_log off;
    return 308 https://ki.example.ch$uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ki.example.ch;
    ssl_certificate /etc/letsencrypt/live/example.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.ch/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    access_log /var/log/nginx/vermittlung-access.log vermittlung_safe;
    error_log /dev/null crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    limit_req_status 429;  # here, not in http: other vhosts may set it already
    client_max_body_size 2m;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_buffering off;       # Streaming der Antworten
    proxy_read_timeout 310s;   # die App wartet bis 300 s
    proxy_send_timeout 60s;

    location = /v1/invitations/redeem {
        limit_req zone=vermittlung_redeem burst=5 nodelay;
        proxy_pass http://127.0.0.1:8010;
    }
    location / {
        limit_req zone=vermittlung_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8010;
    }
}
