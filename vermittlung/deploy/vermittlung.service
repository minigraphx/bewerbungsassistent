# /etc/systemd/system/bewerbungsassistent-vermittlung.service
[Unit]
Description=Bewerbungsassistent KI-Vermittlung (ein Container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/bewerbungsassistent-vermittlung

[Service]
Type=simple
Restart=always
RestartSec=30
WorkingDirectory=/opt/bewerbungsassistent-vermittlung/deploy
ExecStart=/usr/bin/docker compose --env-file /etc/bewerbungsassistent-vermittlung/image.env up --no-build --abort-on-container-exit --exit-code-from vermittlung
ExecStop=/usr/bin/docker compose --env-file /etc/bewerbungsassistent-vermittlung/image.env down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
