<?xml version="1.0" encoding="utf-8"?>
<!-- Template of the trial (#255, #256) and of the Store package (#343), filled in by desktop/msix/manifest.py.
     As it stands: placeholder identity and only runFullTrust. The Store package swaps in the identity of Partner
     Center and turns off both virtualizations with unvirtualizedResources. The protocol and the execution alias
     carry the invitation link and the native messaging host. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="BewerbungsbegleiterVersuch" Publisher="CN=Bewerbungsbegleiter Versuch"
            Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Bewerbungsbegleiter (Versuch)</DisplayName>
    <PublisherDisplayName>Bewerbungsbegleiter Versuch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="de-ch" />
  </Resources>
  <Applications>
    <Application Id="Bewerbungsbegleiter" Executable="Bewerbungsbegleiter.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Bewerbungsbegleiter (Versuch)" Description="Bewerbungsbegleiter als MSIX, nur zum Versuch"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="bewerbungsbegleiter" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Bewerbungsbegleiter</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Bewerbungsbegleiter.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="bewerbungsbegleiter.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
